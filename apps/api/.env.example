# STLL PAY API configuration. Copy to .env for local development.
# Never commit real values. Staging and production read these from the host's secret store.

# development | test | staging | production
ENVIRONMENT=development

# The API connects as the non-owner app role so row-level security applies.
DATABASE_URL=postgresql+asyncpg://stllpay_app:devapp@localhost:5432/stllpay_dev
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgresql+psycopg://stllpay_owner:devowner@localhost:5432/stllpay_dev
APP_DB_ROLE=stllpay_app

# Fernet key for secrets stored in the database (TOTP seeds). Required outside development.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Browser-facing origin of the web app (CSRF origin checks, email links).
WEB_ORIGIN=http://localhost:3000

# console | file
EMAIL_BACKEND=console
EMAIL_OUTBOX_DIR=.outbox

# Payments. Mock by default. Akahu stays off until approved and configured.
PAYMENTS_PROVIDER=mock
# Only allowed in production, and only with PAYMENTS_PROVIDER=akahu.
LIVE_PAYMENTS_ENABLED=false
# Server-side only. Use dedicated STLL PAY credentials, not the finance tracker's.
AKAHU_APP_TOKEN=
AKAHU_APP_SECRET=

LOG_LEVEL=INFO
